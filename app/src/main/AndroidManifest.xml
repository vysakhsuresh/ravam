<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Ravam declares no INTERNET permission, and never will.
      "Nothing leaves your phone" is a claim a manifest can prove, and this is the proof.
      Anything that would need the network — cloud backup, model downloads, in-app
      updates, analytics — is therefore out of scope by construction, not by policy.
    -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optional, used only if granted: the number on a carrier call, and the contact
         name to label it. Ravam works without either; the recording is just labelled
         "Unknown" instead of by name. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Package visibility: without this the probe cannot see whether a VoIP app is
         installed, and reports a false negative on every Android 11+ device. -->
    <queries>
        <package android:name="im.thebot.messenger" />   <!-- BOTIM -->
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
    </queries>

    <application
        android:name=".RavamApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ravam">

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Registers this UID as an accessibility UID, which is what the audio policy's
             call-capture exemption keys on. Reads nothing; see its config. -->
        <service
            android:name=".RavamAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The call trigger: fires on every carrier call, app open or not. This is what
             makes Ravam a call recorder rather than a sound recorder. -->
        <receiver
            android:name=".detect.PhoneCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Re-arms housekeeping and recovers crash-orphaned recordings after a restart. -->
        <receiver
            android:name=".detect.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shares a recording with other apps without exposing the private folder.
             No INTERNET permission, so "share" means the user's own chosen target
             (files, Bluetooth, a messenger) — never an upload by Ravam. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ravam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
