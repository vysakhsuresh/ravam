<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped to nothing.

  accessibilityEventTypes is none, packageNames is this app alone, and no flags that
  would allow reading window content are set. The service exists only so Ravam's UID is
  registered as an accessibility UID, which is what AOSP's audio policy keys its
  call-capture exemption on. It observes nothing about the user's screen, and this file
  is the proof.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:packageNames="com.layerbit.ravam"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_description" />
